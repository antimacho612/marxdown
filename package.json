{
  "name": "marxdown",
  "version": "0.4.1-beta.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "src/main.ts",
    "src/features/editor/lazy/monaco.ts",
    "src/features/document/save.ts",
    "src/features/preview/lazy/search.ts"
  ],
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc --noEmit && svelte-check && vite build",
    "check": "eslint . && prettier --check . && tsc --noEmit && tsc -p tsconfig.e2e.json && svelte-check",
    "fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:memory": "wdio run e2e/wdio.memory.conf.ts",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "size": "size-limit",
    "analyze": "vite build --mode analyze",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "icons": "node scripts/build-icons.mjs",
    "notices": "vite build && node scripts/gen-third-party-notices.mjs",
    "bench:boot": "node scripts/bench-startup.mjs",
    "bench:input": "node scripts/bench-input.mjs",
    "release": "node scripts/release.mjs",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "site": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.4.0",
    "@tauri-apps/api": "^2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/svelte-vite": "10.6.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@wdio/types": "10.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-svelte": "^3.24.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.1.2",
    "size-limit": "^14.3.0",
    "storybook": "10.6.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "10.2.0"
  },
  "packageManager": "pnpm@12.1.0"
}
