{
  "name": "marxdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && svelte-check && vite build",
    "build:app": "tauri build",
    "check": "eslint . && prettier --check . && tsc --noEmit && svelte-check",
    "fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "size": "size-limit",
    "analyze": "vite build --mode analyze",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "icons": "node scripts/build-icons.mjs",
    "bench:boot": "node scripts/bench-startup.mjs",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@replit/codemirror-vscode-keymap": "^6.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@size-limit/file": "^13.0.3",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/svelte-vite": "10.5.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.3",
    "storybook": "10.5.10",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
