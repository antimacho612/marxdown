{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Marxdown.Markdown",
        "description": "Markdown ドキュメント",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 (>= 2.46)"],
        "desktopTemplate": "linux/marxdown.desktop"
      }
    }
  }
}
