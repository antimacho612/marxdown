{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marxdown",
  "version": "../package.json",
  "identifier": "com.antimacho612.marxdown",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "antimacho612",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "© 2026 antimacho612",
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Marxdown.Markdown",
        "description": "Markdown ドキュメント",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NzI1Q0RDMEM3NTIzNjYKUldSbUkzVU0zRnh5eVl2OUlaTFdUWnQrd08wSHZ2a1N6Zy80MHF2Wm4vL2tSdG1seUNnQW5EZVgK",
      "endpoints": ["https://github.com/antimacho612/marxdown/releases/latest/download/latest.json"]
    }
  }
}
