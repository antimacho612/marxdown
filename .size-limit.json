[
  {
    "name": "critical path ja (main + shared + pipeline + i18n core + app css — ADR-0026)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/shared-*.js",
      "dist/assets/pipeline-*.js",
      "dist/assets/i18n-ja-core-*.js",
      "dist/assets/index-*.css",
      "dist/assets/workspace-*.css"
    ],
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "critical path en (main + shared + pipeline + i18n core + app css — ADR-0026)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/shared-*.js",
      "dist/assets/pipeline-*.js",
      "dist/assets/i18n-en-core-*.js",
      "dist/assets/index-*.css",
      "dist/assets/workspace-*.css"
    ],
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "critical path macOS ja (Windows の critical path に OS 別チャンクを足したもの — ADR-0028 §3.3)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/shared-*.js",
      "dist/assets/pipeline-*.js",
      "dist/assets/i18n-ja-core-*.js",
      "dist/assets/index-*.css",
      "dist/assets/workspace-*.css",
      "dist/assets/platform-macos-*.js",
      "dist/assets/macos-*.css",
      "dist/assets/platform-shared-*.js"
    ],
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "critical path Linux ja (Windows の critical path に OS 別チャンクを足したもの — ADR-0028 §3.3)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/shared-*.js",
      "dist/assets/pipeline-*.js",
      "dist/assets/i18n-ja-core-*.js",
      "dist/assets/index-*.css",
      "dist/assets/workspace-*.css",
      "dist/assets/platform-linux-*.js",
      "dist/assets/linux-*.css",
      "dist/assets/platform-shared-*.js"
    ],
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "editor (Monaco / 予算の対象外。上限は回帰検知の番人 — ADR-0009)",
    "path": ["dist/assets/editor-*.js", "dist/assets/editor-*.css"],
    "limit": "850 KB",
    "gzip": true
  },
  {
    "name": "menu (ハンバーガーメニューの中身。押されるまでロードしない)",
    "path": ["dist/assets/menu-*.js"],
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "export (PDF / HTML の書き出し。コマンドを実行するまでロードしない — F-VIEW-18)",
    "path": ["dist/assets/export-*.js"],
    "limit": "4 KB",
    "gzip": true
  },
  {
    "name": "settings (設定 UI。Ctrl+, を押すまでロードしない。6 KB から引き上げた根拠は設計ドキュメントの性能予算にある)",
    "path": ["dist/assets/settings-*.js"],
    "limit": "8 KB",
    "gzip": true
  },
  {
    "name": "themes (配色 50 枚。既定以外の配色を選んでいるか、エディターか設定を開くまでロードしない — ADR-0014)",
    "path": ["dist/assets/theme-*.js"],
    "limit": "14 KB",
    "gzip": true
  },
  {
    "name": "settings samples (設定の見本。プレビュー / エディターのカテゴリを開くまでロードしない)",
    "path": ["dist/assets/sample-*.js"],
    "limit": "2 KB",
    "gzip": true
  },
  {
    "name": "palette (コマンドパレット / クイックオープンと器。Ctrl+Shift+P / Ctrl+P / Ctrl+Shift+O まで読まない)",
    "path": ["dist/assets/palette-*.js"],
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "outline jump (見出しジャンプのパレット。Ctrl+Shift+O を押すまでロードしない)",
    "path": ["dist/assets/outline-*.js"],
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "status menu (ステータスバーの選択肢。押されるまでロードしない)",
    "path": ["dist/assets/status-*.js"],
    "limit": "4 KB",
    "gzip": true
  },
  {
    "name": "update (更新の通知と操作。新しい版が見つかるか、「更新を確認」を選ぶまでロードしない — ADR-0024)",
    "path": ["dist/assets/update-*.js"],
    "limit": "2 KB",
    "gzip": true
  },
  {
    "name": "help (ヘルプの項目と「Marxdown について」。ヘルプの項目を選ぶまでロードしない — ADR-0027)",
    "path": ["dist/assets/help-*.js"],
    "limit": "3 KB",
    "gzip": true
  },
  {
    "name": "i18n ja (遅延チャンクが使う文言。ファイルツリー・設定・更新・ヘルプを開くまでロードしない — ADR-0026)",
    "path": [
      "dist/assets/i18n-ja-explorer-*.js",
      "dist/assets/i18n-ja-help-*.js",
      "dist/assets/i18n-ja-settings-*.js",
      "dist/assets/i18n-ja-update-*.js"
    ],
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "i18n en (遅延チャンクが使う文言。ファイルツリー・設定・更新・ヘルプを開くまでロードしない — ADR-0026)",
    "path": [
      "dist/assets/i18n-en-explorer-*.js",
      "dist/assets/i18n-en-help-*.js",
      "dist/assets/i18n-en-settings-*.js",
      "dist/assets/i18n-en-update-*.js"
    ],
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "bench input (--bench-input のときだけロードする計測経路)",
    "path": ["dist/assets/bench-*.js"],
    "limit": "4 KB",
    "gzip": true
  },
  {
    "name": "highlight (コア + 全言語。1 ドキュメントが読むのはこのうち数個)",
    "path": ["dist/assets/highlight-*.js", "dist/assets/hljs-*.js"],
    "limit": "45 KB",
    "gzip": true
  },
  {
    "name": "math (KaTeX。数式を含む文書を開くまでロードしない)",
    "path": ["dist/assets/math-*.js", "dist/assets/math-*.css"],
    "limit": "85 KB",
    "gzip": true
  },
  {
    "name": "mermaid (図を含む文書で、図が画面に入るまでロードしない。予算の対象外。900 KB から引き上げた根拠は設計ドキュメントの性能予算にある)",
    "path": ["dist/assets/mermaid-*.js", "dist/assets/mermaid-*.css"],
    "limit": "1400 KB",
    "gzip": true
  },
  {
    "name": "marp (Marp のスライド。marp: true の文書を開くまでロードしない。予算の対象外 — ADR-0023)",
    "path": ["dist/assets/marp-*.js", "dist/assets/i18n-*-marp-*.js"],
    "limit": "200 KB",
    "gzip": true
  },
  {
    "name": "total ja (no mermaid, no math, no marp, no editor, no i18n-en)",
    "path": [
      "dist/assets/*.js",
      "!dist/assets/mermaid-*.js",
      "!dist/assets/math-*.js",
      "!dist/assets/marp-*.js",
      "!dist/assets/editor-*.js",
      "!dist/assets/i18n-*-marp-*.js",
      "!dist/assets/i18n-en-*.js"
    ],
    "limit": "240 KB",
    "gzip": true
  },
  {
    "name": "total en (no mermaid, no math, no marp, no editor, no i18n-ja)",
    "path": [
      "dist/assets/*.js",
      "!dist/assets/mermaid-*.js",
      "!dist/assets/math-*.js",
      "!dist/assets/marp-*.js",
      "!dist/assets/editor-*.js",
      "!dist/assets/i18n-*-marp-*.js",
      "!dist/assets/i18n-ja-*.js"
    ],
    "limit": "240 KB",
    "gzip": true
  }
]
