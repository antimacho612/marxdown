[
  {
    "name": "critical path (main + md-worker)",
    "path": ["dist/assets/main-*.js", "dist/assets/md-worker-*.js"],
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "editor (上限の根拠は 05.performance-budget.md §5.1)",
    "path": ["dist/assets/editor-*.js", "dist/assets/spike-editor-*.js"],
    "limit": "215 KB",
    "gzip": true
  },
  {
    "name": "menu (ハンバーガーメニューの中身。押されるまでロードしない)",
    "path": ["dist/assets/menu-*.js"],
    "limit": "6 KB",
    "gzip": true
  },
  {
    "name": "highlight (コア + 全言語。1 ドキュメントが読むのはこのうち数個)",
    "path": ["dist/assets/highlight-*.js", "dist/assets/hljs-*.js"],
    "limit": "45 KB",
    "gzip": true
  },
  {
    "name": "total (no mermaid) — 上限の根拠は 05.performance-budget.md §5.1",
    "path": ["dist/assets/*.js", "!dist/assets/mermaid-*.js"],
    "limit": "450 KB",
    "gzip": true
  }
]
