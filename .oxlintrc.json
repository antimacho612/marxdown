{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }],
    "import/no-cycle": "error",

    // React 17+ の新しい JSX 変換を使っているため、React を import する必要はない
    "react/react-in-jsx-scope": "off",

    // Rust 側の initialization_script が注入するグローバルの命名規約
    "no-underscore-dangle": [
      "error",
      { "allow": ["__MARXDOWN_BOOTSTRAP__", "__MARXDOWN_T4__", "__TAURI_INTERNALS__"] }
    ],

    // Worker の postMessage に targetOrigin は存在しない（window.postMessage 用のルール）
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**", "*.config.ts", "vitest.config.ts", "vite.config.ts"],
      "env": { "node": true, "browser": false },
      "rules": {
        "no-console": "off",
        // 計測スクリプトは「1 回ずつ順番に実行する」ことが要件そのもの。
        // 並列化すると計測値が壊れる。
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/spike/**", "bench/**"],
      "rules": { "no-console": "off" }
    },
    {
      // CSS の副作用インポートと、テストのセットアップは代入しようがない
      "files": ["src/main.tsx", "tests/setup.ts"],
      "rules": { "import/no-unassigned-import": "off" }
    },
    {
      // `export {}` は .d.ts をモジュールにするために必要
      "files": ["**/*.d.ts"],
      "rules": { "unicorn/require-module-specifiers": "off" }
    },
    {
      "files": ["tests/**", "**/*.test.ts", "**/*.test.tsx", "**/*.bench.ts"],
      "rules": { "typescript/no-explicit-any": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "src-tauri/target", "bench/fixtures"]
}
